<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
    <dict>
        <key>name</key>
        <string>Snooker</string>
        <key>colorSpaceName</key>
        <string>sRGB</string>
        <key>settings</key>
        <array>
            <dict>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#adad9b</string>
                    <key>gutterForeground</key>
                    <string>#08000000</string>
                    <key>invisibles</key>
                    <string>#08000000</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Comments</string>
                <key>scope</key>
                <string>comment</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#08000000</string>
                    <key>fontStyle</key>
                    <string>italic</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Strings</string>
                <key>scope</key>
                <string>string</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#06000000</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Constants</string>
                <key>scope</key>
                <string>constant, constant.numeric, constant.language, constant.character</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#0e000000</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Identifiers</string>
                <key>scope</key>
                <string>variable, entity.name.function, support.function</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#04000000</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Statements</string>
                <key>scope</key>
                <string>keyword, storage, keyword.control, keyword.operator</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#02000000</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Exceptions</string>
                <key>scope</key>
                <string>invalid, keyword.control.exception</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#09000000</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Preprocessor</string>
                <key>scope</key>
                <string>meta.preprocessor, keyword.control.import, keyword.control.directive</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#05000000</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Types</string>
                <key>scope</key>
                <string>storage.type, entity.name.type, support.type, entity.name.class</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#0b000000</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Special</string>
                <key>scope</key>
                <string>entity.name.tag, punctuation, meta.tag, support.constant</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#03000000</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Errors</string>
                <key>scope</key>
                <string>invalid.illegal, invalid.deprecated</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#0f000000</string>
                    <key>background</key>
                    <string>#01000000</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Todo</string>
                <key>scope</key>
                <string>comment.todo, meta.annotation</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#0d000000</string>
                    <key>fontStyle</key>
                    <string>bold</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Diff Added</string>
                <key>scope</key>
                <string>markup.inserted, meta.diff.range</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#0a000000</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Diff Changed</string>
                <key>scope</key>
                <string>markup.changed</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#0c000000</string>
                </dict>
            </dict>
            <dict>
                <key>name</key>
                <string>Diff Removed</string>
                <key>scope</key>
                <string>markup.deleted</string>
                <key>settings</key>
                <dict>
                    <key>foreground</key>
                    <string>#01000000</string>
                </dict>
            </dict>
        </array>
        <key>uuid</key>
        <string>com.gabenespoli.bat.snooker</string>
    </dict>
</plist>
