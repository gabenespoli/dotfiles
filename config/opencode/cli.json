{
  "$schema": "https://opencode.ai/v2/cli.json",
  "theme": {
    "name": "system"
  },
  "diffs": {
    "wrap": "word"
  },
  "session": {
    "sidebar": "hide",
    "scrollbar": false,
    "thinking": "show"
  },
  "animations": true,
  "cursor": {
    "blinking": false,
  },
  "keybinds": {
    "agent.cycle": ["tab", "shift+tab"]
  }
}
