    "terminal.ansiBrightYellow": "#a58010",
    "terminal.ansiBlue": "#0085ba",
    "terminal.ansiBrightBlue": "#008cb0",
    "terminal.ansiMagenta": "#7560c4",
    "terminal.ansiBrightMagenta": "#c85a5d",
    "terminal.ansiCyan": "#18956f",
    "terminal.ansiBrightCyan": "#389048",
    "terminal.ansiWhite": "#252a25",
    "terminal.ansiBrightWhite": "#0f171b"
  },
  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#b0b09e",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "constant.character",
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#18956f"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#389048"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#0085ba"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type.function",
        "storage.type.class",
        "keyword.operator.logical",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#1c8c38"
      }
    },
    {
      "scope": [
        "keyword.control.exception",
        "keyword.control.trycatch"
      ],
      "settings": {
        "foreground": "#d07815"
      }
    },
    {
      "scope": [
        "keyword.control.import",
        "keyword.control.from",
        "meta.preprocessor",
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.definition.decorator",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#7560c4"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type"
      ],
      "settings": {
        "foreground": "#a58010"
      }
    },
    {
      "scope": [
        "support.type.builtin",
        "support.function.builtin",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#8f6228"
      }
    },
    {
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.section",
        "punctuation.definition.parameters",
        "punctuation.definition.arguments",
        "punctuation.parenthesis"
      ],
      "settings": {
        "foreground": "#b0b09e"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "variable",
        "variable.other",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#2d2d24"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e52e1a"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#0f171b",
        "fontStyle": "bold italic"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#252a25",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#252a25",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#0085ba",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#389048"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#1a9a3e"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#e52e1a"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#008cb0"
      }
    },
    {
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.sql",
        "keyword.other.alias.sql"
      ],
      "settings": {
        "foreground": "#1c8c38"
      }
    }
  ],
  "semanticTokenColors": {
    "parameter": "#7560c4",
    "module": "#2d2d24",
    "class": "#a58010",
    "class.builtin": "#8f6228",
    "function.builtin": "#8f6228",
    "variable.readonly.constant": "#389048"
  }
}
