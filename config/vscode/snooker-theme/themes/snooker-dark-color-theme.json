  "tokenColors": [
    {
      "scope": [
        "comment",
        "punctuation.definition.comment",
        "string.comment"
      ],
      "settings": {
        "foreground": "#6a6a5b",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "string",
        "string.quoted",
        "constant.character",
        "constant.numeric"
      ],
      "settings": {
        "foreground": "#1dae87"
      }
    },
    {
      "scope": [
        "constant",
        "constant.language",
        "support.constant",
        "variable.other.constant"
      ],
      "settings": {
        "foreground": "#4abe65"
      }
    },
    {
      "scope": [
        "entity.name.function",
        "support.function",
        "meta.function-call.generic",
        "variable.function"
      ],
      "settings": {
        "foreground": "#0094cf"
      }
    },
    {
      "scope": [
        "keyword",
        "keyword.control",
        "storage.type.function",
        "storage.type.class",
        "keyword.operator.logical",
        "keyword.operator.new"
      ],
      "settings": {
        "foreground": "#1c9c40"
      }
    },
    {
      "scope": [
        "keyword.control.exception",
        "keyword.control.trycatch"
      ],
      "settings": {
        "foreground": "#ea901a"
      }
    },
    {
      "scope": [
        "keyword.control.import",
        "keyword.control.from",
        "meta.preprocessor",
        "entity.name.function.decorator",
        "meta.decorator",
        "punctuation.definition.decorator",
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#8b72da"
      }
    },
    {
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "support.type",
        "support.class",
        "entity.other.inherited-class",
        "storage.type"
      ],
      "settings": {
        "foreground": "#c89b13"
      }
    },
    {
      "scope": [
        "support.type.builtin",
        "support.function.builtin",
        "constant.character.escape",
        "string.regexp"
      ],
      "settings": {
        "foreground": "#a57230"
      }
    },
    {
      "scope": [
        "punctuation.separator",
        "punctuation.terminator",
        "punctuation.section",
        "punctuation.definition.parameters",
        "punctuation.definition.arguments",
        "punctuation.parenthesis"
      ],
      "settings": {
        "foreground": "#6a6a5b"
      }
    },
    {
      "scope": [
        "keyword.operator",
        "variable",
        "variable.other",
        "entity.name.namespace"
      ],
      "settings": {
        "foreground": "#adad9b"
      }
    },
    {
      "scope": [
        "invalid",
        "invalid.illegal"
      ],
      "settings": {
        "foreground": "#e52e1a"
      }
    },
    {
      "scope": [
        "markup.heading",
        "entity.name.section"
      ],
      "settings": {
        "foreground": "#e5e5d2",
        "fontStyle": "bold italic"
      }
    },
    {
      "scope": [
        "markup.bold"
      ],
      "settings": {
        "foreground": "#cdc08b",
        "fontStyle": "bold"
      }
    },
    {
      "scope": [
        "markup.italic"
      ],
      "settings": {
        "foreground": "#cdc08b",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#0094cf",
        "fontStyle": "italic"
      }
    },
    {
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code"
      ],
      "settings": {
        "foreground": "#4abe65"
      }
    },
    {
      "scope": [
        "markup.inserted"
      ],
      "settings": {
        "foreground": "#22bd4e"
      }
    },
    {
      "scope": [
        "markup.deleted"
      ],
      "settings": {
        "foreground": "#e52e1a"
      }
    },
    {
      "scope": [
        "markup.changed"
      ],
      "settings": {
        "foreground": "#00a3cc"
      }
    },
    {
      "scope": [
        "keyword.other.DML.sql",
        "keyword.other.sql",
        "keyword.other.alias.sql"
      ],
      "settings": {
        "foreground": "#1c9c40"
      }
    }
  ],
  "semanticTokenColors": {
    "parameter": "#8b72da",
    "module": "#adad9b",
    "class": "#c89b13",
    "class.builtin": "#a57230",
    "function.builtin": "#a57230",
    "variable.readonly.constant": "#4abe65"
  }
}
