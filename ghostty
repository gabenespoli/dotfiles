# system  {{{1
auto-update = check
clipboard-read = allow
clipboard-write = allow
macos-titlebar-style = hidden
macos-icon = custom-style
macos-icon-frame = beige
macos-icon-ghost-color = ffffff
macos-icon-screen-color = 000000

# terminal  {{{1
resize-overlay = never
cursor-style = block
cursor-style-blink = false
shell-integration-features = no-cursor
font-family = MonoLisaWSLiga Nerd Font
font-size = 14
font-thicken = true
adjust-cell-width = -1

# keybindings  {{{1
keybind = cmd+zero=text:\x1b0
keybind = cmd+digit_1=text:\x1b1
keybind = cmd+digit_2=text:\x1b2
keybind = cmd+digit_3=text:\x1b3
keybind = cmd+digit_4=text:\x1b4
keybind = cmd+digit_5=text:\x1b5
keybind = cmd+digit_6=text:\x1b6
keybind = cmd+digit_7=text:\x1b7
keybind = cmd+digit_8=text:\x1b8
keybind = cmd+digit_9=text:\x1b9
keybind = cmd+b=text:\x1bb
keybind = cmd+d=text:\x1bd
keybind = cmd+f=text:\x1bf
keybind = cmd+h=text:\x1bh
keybind = cmd+j=text:\x1bj
keybind = cmd+k=text:\x1bk
keybind = cmd+l=text:\x1bl
keybind = cmd+o=text:\x1bo
keybind = cmd+shift+o=text:\x1bO
keybind = cmd+s=text:\x1bs
keybind = cmd+t=text:\x1bt
keybind = "cmd+shift+left_bracket=text:\x1b{"
keybind = "cmd+shift+right_bracket=text:\x1b}"
keybind = cmd+shift+digit_9=text:\x1b(
keybind = cmd+shift+digit_0=text:\x1b)

# colors  {{{1
theme = dark:snooker-dark,light:snooker-light
